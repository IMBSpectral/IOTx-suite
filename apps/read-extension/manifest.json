{
  "manifest_version": 3,
  "name": "IOTx Read: meeting notes",
  "short_name": "IOTx Read",
  "version": "1.0.0",
  "description": "Notes for Google Meet, Zoom and Teams calls, recorded in your browser (no bot joins). Reports appear in IOTx Meet.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "IOTx Read",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["tabCapture", "offscreen", "storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://imbspectral.online/*",
    "http://localhost:3100/*",
    "http://127.0.0.1:3100/*",
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
