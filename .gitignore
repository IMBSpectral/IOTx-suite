# Dependencies, builds and caches
node_modules/
.next/
dist/
target/
*.tsbuildinfo
.builds/
deploy/out/
*.tgz
*.zip

# Runtime data: user projects, uploaded files, logs
projects-data/
storage/
.logs/
*.log

# Tools and scratch
.playwright-mcp/
.claude/
New folder/
*.png
